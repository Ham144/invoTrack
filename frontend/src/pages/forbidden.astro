---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Akses Ditolak">
  <div class="flex min-h-screen items-center justify-center bg-base-200 p-6">
    <div class="card bg-base-100 border border-base-300 shadow-lg max-w-md w-full">
      <div class="card-body items-center text-center gap-4">
        <div class="w-16 h-16 rounded-full bg-error/10 flex items-center justify-center text-error text-2xl font-bold">
          403
        </div>
        <h1 class="text-xl font-bold">Akses ditolak</h1>
        <p class="text-sm text-base-content/70">
          Anda tidak memiliki hak akses ke halaman ini. Hubungi admin organisasi jika ini keliru.
        </p>
        <div class="card-actions flex-col w-full gap-2 mt-2">
          <a href="/dashboard" class="btn btn-primary w-full">Kembali ke Ringkasan</a>
          <a href="/" class="btn btn-ghost btn-sm w-full">Ke beranda</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
